{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "skipLibCheck": false,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "server.ts",
    "app.tsx",
    "legacy-entry.ts",
    "provider.ts",
    "host.ts",
    "contract.ts",
    "dashboard.ts",
    "usage.ts",
    "session-credits.tsx",
    "icon-paths.ts",
    "components",
    "lib",
    "bin/copilot-api.d.mts"
  ]
}
